<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="20"
			 x:Class="PSMultiTools.Menus.PS5Menu" Height="20">
	<Grid>
		<Menu x:Name="MainMenu">
			<MenuItem Header="Library"/>

			<MenuItem x:Name="ToolsMenuItem" Header="Tools">
				<MenuItem Header="PC Utilities">
					<MenuItem Header="Appinfo Database Updater" x:Name="OpenAppInfoUpdaterMenuItem" Click="OpenAppInfoUpdaterMenuItem_Click">
						<ToolTip.Tip>
							Burn an ISO file to a Blu-Ray disc.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Blu-Ray Disc Burner" x:Name="OpenBDBurnerMenuItem" Click="OpenBDBurnerMenuItem_Click">
						<ToolTip.Tip>
							Burn an ISO file to a Blu-Ray disc.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Check for PS Multi Tools updates" x:Name="CheckForUpdatesMenuItems" Click="CheckForUpdatesMenuItems_Click">
					</MenuItem>
					<MenuItem Header="Extract RCO files" x:Name="OpenRCOExtractorMenuItem" Click="OpenRCOExtractorMenuItem_Click">
						<ToolTip.Tip>
							Extract a PSP, PS3, PS Vita, PS4 or PS5 Resource Container (*.rco).
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Fake sign SELF files" x:Name="OpenMakefSELFMenuItem" Click="OpenMakefSELFMenuItem_Click">
						<ToolTip.Tip>
							Fake sign executable ELF files of a dumped game or app (4.03 max.).
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="GP5 Project Creator" x:Name="OpenGP5ManagerMenuItem" Click="OpenGP5ManagerMenuItem_Click">
						<ToolTip.Tip>
							Create a PS5 Package Project (*.gp5).
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Manifest JSON Editor" x:Name="OpenManifestEditorMenuItem" Click="OpenManifestEditorMenuItem_Click">
						<ToolTip.Tip>
							Create/Modify a PS5 manifest.json file.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Param JSON Editor" x:Name="OpenParamEditorMenuItem" Click="OpenParamEditorMenuItem_Click">
						<ToolTip.Tip>
							Create/Modify a PS5 param.json file.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Payload Builder" x:Name="PayloadBuilderMenuItem" Click="PayloadBuilderMenuItem_Click">
						<ToolTip.Tip>
							Auto-Build ELF payloads for the PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Payload &amp; Mast1c0re PS2 Game Sender" x:Name="SenderMenuItem" Click="SenderMenuItem_Click">
						<ToolTip.Tip>
							Send ELF/BIN payloads or a PS2 game for Mast1c0re to an exploited PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PKG Builder" x:Name="OpenPKGBuilderMenuItem" Click="OpenPKGBuilderMenuItem_Click">
						<ToolTip.Tip>
							Build a PKG file from a GP5 project file.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PKG Extractor" x:Name="OpenPKGExtractorMenuItem" Click="OpenPKGExtractorMenuItem_Click">
						<ToolTip.Tip>
							Extract a PS5 PKG file using a passcode or integrated ps5dec (keys). Using 'ps5dec' requires an updated OS because the 'SHA3_256' function is not supported on every Operating System.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PKG Merger" x:Name="OpenPKGMergerMenuItem" Click="OpenPKGMergerMenuItem_Click">
						<ToolTip.Tip>
							Merge multiple PKG files into a single PKG.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PKG Reader (Viewer)" x:Name="OpenPKGReaderMenuItem" Click="OpenPKGReaderMenuItem_Click">
						<ToolTip.Tip>
							Show the content of a PS5 PKG file.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PKG Sender" x:Name="OpenPKGSenderMenuItem" Click="OpenPKGSenderMenuItem_Click"/>
					<MenuItem Header="Port Checker" x:Name="OpenPortCheckerMenuItem" Click="OpenPortCheckerMenuItem_Click">
						<ToolTip.Tip>
							Check which ports are open or closed the PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="PS Classics fPKG Builder" x:Name="OpenPSClassicsfPKGBuilderMenuItem" Click="OpenPSClassicsfPKGBuilderMenuItem_Click">
						<ToolTip.Tip>
							Build a PS4/PS5 compatible fPKG file from a PS1, PS2 or PSP game.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="SELF Decrypter" x:Name="OpenSELFDecrypterMenuItem" Click="OpenSELFDecrypterMenuItem_Click">
						<ToolTip.Tip>
							Send a backup or SELF dumper payload to the PS5 and watch the dump creation progress.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Simple Shortcut PKG Creator" x:Name="OpenShortcutPKGCreatorMenuItem" Click="OpenShortcutPKGCreatorMenuItem_Click">
						<ToolTip.Tip>
							Create a simple PS5 PKG file that opens a specific URL or action.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="WAV &lt;-&gt; AT9 Converter" x:Name="OpenAudioConverterMenuItem" Click="OpenAudioConverterMenuItem_Click">
						<ToolTip.Tip>
							Convert custom WAV to AT9 or convert AT9 soundtrack to WAV.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
				<MenuItem Header="PS5 - Requires a running FTP server">
					<MenuItem Header="Clear the error history on PS5" x:Name="ClearErrorHistoryMenuItem" Click="ClearErrorHistoryMenuItem_Click"/>
					<MenuItem Header="Disc Info Reader" x:Name="OpenDiscParamReaderMenuItem" Click="OpenDiscParamReaderMenuItem_Click">
						<ToolTip.Tip>
							Display information about the inserted disc in the PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Dump RCO files" x:Name="OpenRCODumperMenuItem" Click="OpenRCODumperMenuItem_Click">
						<ToolTip.Tip>
							Dump the Resource Container (*.rco) files from the PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="etaHEN Configurator" x:Name="OpenetaHENConfiguratorMenuItem" Click="OpenetaHENConfiguratorMenuItem_Click">
						<ToolTip.Tip>
							Configurate etaHEN options.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="FTP Browser" x:Name="OpenFTPBrowserMenuItem" Click="OpenFTPBrowserMenuItem_Click"/>
					<MenuItem Header="FTP Grabber (Dumper)" x:Name="OpenFTPGrabberMenuItem" Click="OpenFTPGrabberMenuItem_Click">
						<ToolTip.Tip>
							Create a game/app backup using FTP. This will always take longer than directly dumping on the console but this option dumps directly on your PC in case you have no USB.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Notifications Manager" x:Name="OpenNotificationManagerMenuItem" Click="OpenNotificationManagerMenuItem_Click">
						<ToolTip.Tip>
							Manage your notifications on the PS5 and add custom shortcuts.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Web Browser Installer" x:Name="OpenWebBrowserInstallerMenuItem" Click="OpenWebBrowserInstallerMenuItem_Click">
						<ToolTip.Tip>
							Install the Web Browser app on the PS5.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
				<MenuItem Header="PS5 - Requires a running KLog server">
					<MenuItem Header="Kernel Log Viewer" x:Name="OpenKLogViewerMenuItem" Click="OpenKLogViewerMenuItem_Click">
						<ToolTip.Tip>
							Monitor the kernel log of the PS5 with the possibility to filter/colorize text.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
				<MenuItem Header="PS5 - Requires a running ELF loader">
					<MenuItem Header="Spoof firmware to max version" x:Name="SpoofFWMenuItem" Click="SpoofFWMenuItem_Click">
						<ToolTip.Tip>
							This will send automatically a payload that spoofs the firmware to the max. version.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Toggle kstuff" x:Name="Togglekstuff" Click="Togglekstuff_Click">
						<ToolTip.Tip>
							This will send automatically the kstuff-toggle payload to the PS5.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
			</MenuItem>

