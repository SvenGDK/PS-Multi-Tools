			<MenuItem x:Name="WebManMenuItem" Header="webMAN for websrv">
				<TextBlock Text="Requires WebSrv running" FontWeight="Bold" TextDecorations="Underline">
					<ToolTip.Tip>
						In order to use any of these utilities you will need to send the WebSrv payload first to the PS5.
					</ToolTip.Tip>
				</TextBlock>
				<MenuItem Header="Emulator Utilities">
					<MenuItem Header="Manage ROMs of Homebrew Emulators" x:Name="ManagePS5GameROMs" Click="ManagePS5GameROMs_Click">
						<ToolTip.Tip>
							Allows to manage your game ROMs of any emulator that is placed in '/data/homebrew'.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
				<MenuItem Header="General Utilities">
					<MenuItem Header="Open PS5 WebServer Interface" x:Name="OpenPS5WebSrvInterface" Click="OpenPS5WebSrvInterface_Click">
						<ToolTip.Tip>
							Opens a window with the WebSrv's homepage where you can view your installed homebrew and games and start them directly.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Browse PS5 File System" x:Name="BrowsePS5FileSystem" Click="BrowsePS5FileSystem_Click">
						<ToolTip.Tip>
							Shows an overwiew of the PS5 file system. The window is read-only and no modifications are possible.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Manage installed Homebrew" x:Name="ManagePS5Homebrew" Click="ManagePS5Homebrew_Click">
						<ToolTip.Tip>
							Allows to manage your installed homebrew '/data/homebrew'.
						</ToolTip.Tip>
					</MenuItem>
				</MenuItem>
			</MenuItem>
			<MenuItem x:Name="TelnetMenuItem" Header="Commands for shsrv">
				<TextBlock Text="Requires ShSrv running" FontWeight="Bold" TextDecorations="Underline">
					<ToolTip.Tip>
						In order to use any of these utilities you will need to send the SHSrv payload first to the PS5.
					</ToolTip.Tip>
				</TextBlock>
				<MenuItem Header="Read Console Information">
					<MenuItem Header="Get Model, Serial Number, Software Version &amp; Temperatures" x:Name="GetConsoleInfo" Click="GetConsoleInfo_Click">
						<ToolTip.Tip>
							Display information about Model, Serial Number, Software Version &amp; Temperatures of the PS5.
						</ToolTip.Tip>
					</MenuItem>
					<MenuItem Header="Get AuthID" x:Name="GetAuthID" Click="GetAuthID_Click"/>
				</MenuItem>
			</MenuItem>
