<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
		x:Class="PSMultiTools.PS4.Tools.PS4PKGExtractor"
		Title="PS4 PKG Extractor" Height="600" Width="640" CanResize="False" CanMinimize="True" WindowStartupLocation="CenterScreen" RequestedThemeVariant="Dark">
	<Grid>
		<Button x:Name="BrowsePKGButton" Content="Browse" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="551,33,0,0" VerticalAlignment="Top" Width="74" Click="BrowsePKGButton_Click"/>
		<TextBox x:Name="SelectedPKGFileTextBox" HorizontalAlignment="Left" Margin="10,34,0,0" VerticalAlignment="Top" Width="536"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,10,0,0"  Text="Select a PS4 PKG / fPKG file :" VerticalAlignment="Top"  FontSize="14"/>
		<Image x:Name="PKGICONImage" HorizontalAlignment="Left" Height="128" Margin="10,210,0,0" VerticalAlignment="Top" Width="128" Source="/Images/PKG.png"/>
		<Button x:Name="ExtractButton" Content="Extract" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="551,165,0,0" VerticalAlignment="Top" Width="74" FontWeight="Bold" Click="ExtractButton_Click"/>
		<TextBox x:Name="LogTextBox" HorizontalAlignment="Left" Margin="10,375,0,0"  VerticalAlignment="Top" Width="615" Height="205"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,351,0,0"  Text="Extraction Log :" VerticalAlignment="Top"  FontSize="14"/>
		<TextBlock x:Name="PKGTitleTextBlock" HorizontalAlignment="Left" Margin="151,237,0,0"  Text="Title :" VerticalAlignment="Top"  FontSize="14"/>
		<TextBlock x:Name="IDTextBlock" HorizontalAlignment="Left" Margin="151,261,0,0"  Text="ID :" VerticalAlignment="Top"  FontSize="14"/>
		<TextBlock x:Name="TypeTextBlock" HorizontalAlignment="Left" Margin="151,285,0,0"  Text="Type :" VerticalAlignment="Top"  FontSize="14"/>
		<TextBox x:Name="PKGPasscodeTextBox" HorizontalAlignment="Left" Margin="10,166,0,0" VerticalAlignment="Top" Width="536" TextAlignment="Center"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,142,0,0"  Text="Enter a passcode (optional for fPKG) :" VerticalAlignment="Top"  FontSize="14"/>
		<Button x:Name="BrowseOutputFolderButton" Content="Browse" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="551,99,0,0" VerticalAlignment="Top" Width="74" Click="BrowseOutputFolderButton_Click"/>
		<TextBox x:Name="SelectedOutputFolderTextBox" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top" Width="536"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,76,0,0"  Text="Select an output folder :" VerticalAlignment="Top"  FontSize="14"/>
	</Grid>
</Window>
