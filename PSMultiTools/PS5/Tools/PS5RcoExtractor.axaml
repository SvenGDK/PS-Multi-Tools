<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
		x:Class="PSMultiTools.PS5.Tools.PS5RcoExtractor"
		Title="RCO Extractor" Height="120" Width="400" CanResize="False" CanMinimize="True" WindowStartupLocation="CenterScreen" RequestedThemeVariant="Dark">
	<Grid>
		<TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="Select an .rco file or a folder containing .rco files:" VerticalAlignment="Top" FontSize="14" Width="320"/>
		<TextBox x:Name="SelectedRCOPathTextBox" HorizontalAlignment="Left" Margin="10,34,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="380"/>
		<Button x:Name="BrowseFileButton" Content="Browse file" HorizontalContentAlignment="Center" Width="100" Margin="10,75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BrowseFileButton_Click"/>
		<Button x:Name="BrowseFolderButton" Content="Browse folder" HorizontalContentAlignment="Center" Margin="115,75,0,0" Width="125" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BrowseFolderButton_Click"/>
		<Button x:Name="ExtractButton" Content="Extract" HorizontalContentAlignment="Center" Margin="305,75,0,0" Width="85" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ExtractButton_Click"/>
	</Grid>
</Window>
