<Window xmlns="https://github.com/avaloniaui"
        xmlns:avaloniaedit="using:AvaloniaEdit"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
		x:Class="PSMultiTools.PS5.Tools.PS5Log"
		Title="PS5 klog Viewer" Height="700" Width="1080" RequestedThemeVariant="Dark" WindowStartupLocation="CenterScreen">
	<Grid>
		<TextBlock FontFamily="Calibri" FontSize="16" Text="Connection Settings :" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold"/>
		<TextBlock FontFamily="Calibri" FontSize="14" Text="IP Address :" Margin="10,36,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<TextBlock FontFamily="Calibri" FontSize="14" Text="Port :" Margin="45,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<TextBox x:Name="PS5IPTextBox" HorizontalAlignment="Left" Margin="84,35,0,0" VerticalAlignment="Top" Width="250" FontFamily="Calibri" FontSize="14" TextAlignment="Center"/>
		<TextBox x:Name="PS5KlogPortTextBox" HorizontalAlignment="Left" Margin="84,69,0,0" VerticalAlignment="Top" Width="250" FontFamily="Calibri" FontSize="14" TextAlignment="Center" Text="9081"/>
		<Button x:Name="ReconnectButton" Content="Connect" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="339,55,0,0" VerticalAlignment="Top" Width="100" Click="ReconnectButton_Click"/>

		<TextBlock FontFamily="Calibri" FontSize="16" Text="Utilities :" Margin="10,115,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold"/>
		<Button x:Name="ClearButton" Content="Clear klog" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,140,0,0" VerticalAlignment="Top" Width="120" FontFamily="Calibri" Click="ClearButton_Click"/>
		<Button x:Name="ClearHighlightsButton" Content="Clear highlight rules" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="145,140,0,0" VerticalAlignment="Top" Width="135" FontFamily="Calibri" Click="ClearHighlightsButton_Click"/>
		<Button x:Name="ResetColorButton" Content="Reset BG &amp; Text color" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="285,140,0,0" VerticalAlignment="Top" Width="150" FontFamily="Calibri" Click="ResetColorButton_Click"/>

		<TextBlock FontFamily="Calibri" FontSize="16" Text="Log Settings :" Margin="455,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold"/>

		<TextBlock FontFamily="Calibri" FontSize="14" Text="Font Size :" Margin="455,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<ComboBox x:Name="FontSizeComboBox" HorizontalAlignment="Left" Margin="570,34,0,0" VerticalAlignment="Top" Width="157" FontFamily="Calibri" SelectedIndex="6">
			<ComboBoxItem Content="6"/>
			<ComboBoxItem Content="7"/>
			<ComboBoxItem Content="8"/>
			<ComboBoxItem Content="9"/>
			<ComboBoxItem Content="10"/>
			<ComboBoxItem Content="11"/>
			<ComboBoxItem Content="12"/>
			<ComboBoxItem Content="14"/>
			<ComboBoxItem Content="16"/>
			<ComboBoxItem Content="18"/>
			<ComboBoxItem Content="20"/>
		</ComboBox>
		<TextBlock FontFamily="Calibri" FontSize="10" Text="(changes by selection)" Margin="740,40,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"/>

		<TextBlock FontFamily="Calibri" FontSize="14" Text="Highlight word :" Margin="455,80,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<ComboBox x:Name="HighlightSelectionComboBox" HorizontalAlignment="Left" Margin="570,75,0,0" VerticalAlignment="Top" Width="157" FontFamily="Calibri" SelectedIndex="0" IsEditable="True">
			<ComboBoxItem Content="[Amm]"/>
			<ComboBoxItem Content="[AppMgr]"/>
			<ComboBoxItem Content="[AppMgr Trace]"/>
			<ComboBoxItem Content="[AutoMounterWrapper]"/>
			<ComboBoxItem Content="[AvControl]"/>
			<ComboBoxItem Content="[AppDb]"/>
			<ComboBoxItem Content="[BAPM]"/>
			<ComboBoxItem Content="[CRSUI]"/>
			<ComboBoxItem Content="[DRIVEAUTH]"/>
			<ComboBoxItem Content="[ERROR]"/>
			<ComboBoxItem Content="[INF]"/>
			<ComboBoxItem Content="[Info]"/>
			<ComboBoxItem Content="[KERNEL]"/>
			<ComboBoxItem Content="[libSceSaveData]"/>
			<ComboBoxItem Content="[MediaEventListener]"/>
			<ComboBoxItem Content="[NoticeScreenSkip]"/>
			<ComboBoxItem Content="[NotificationDb]"/>
			<ComboBoxItem Content="[NotifyGameDiscInserted]"/>
			<ComboBoxItem Content="[NpPush]"/>
			<ComboBoxItem Content="[PFAuthClient]"/>
			<ComboBoxItem Content="[PFS]"/>
			<ComboBoxItem Content="[PGraphics]"/>
			<ComboBoxItem Content="[PlayGoCore]"/>
			<ComboBoxItem Content="[PSM]"/>
			<ComboBoxItem Content="[PSM/N video_csharp]"/>
			<ComboBoxItem Content="[PPR PFS]"/>
			<ComboBoxItem Content="[ProfileCacheManager]"/>
			<ComboBoxItem Content="[PsvrUpdater]"/>
			<ComboBoxItem Content="[PUBSUB]"/>
			<ComboBoxItem Content="[ResArbitrator]"/>
			<ComboBoxItem Content="[SceCdlgApp]"/>
			<ComboBoxItem Content="[SceHidConfigService]"/>
			<ComboBoxItem Content="[SceLncService]"/>
			<ComboBoxItem Content="[SceLncUtil]"/>
			<ComboBoxItem Content="[ScePatchChecker]"/>
			<ComboBoxItem Content="[sceProcessStarter]"/>
			<ComboBoxItem Content="[ScePs4AppCategory]"/>
			<ComboBoxItem Content="[ScePsmUtil]"/>
			<ComboBoxItem Content="[SceRnpsAppMgr]"/>
			<ComboBoxItem Content="[SceShellCore]"/>
			<ComboBoxItem Content="[SceShellUI]"/>
			<ComboBoxItem Content="[SceSystemStateMgr]"/>
			<ComboBoxItem Content="[SceWorkaroundCtl]"/>
			<ComboBoxItem Content="[Syscore App]"/>
			<ComboBoxItem Content="[Syscore Umd]"/>
			<ComboBoxItem Content="[TTS Arbitrator]"/>
		</ComboBox>
		<TextBlock FontFamily="Calibri" FontSize="14" Text="with color :" Margin="740,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<TextBox x:Name="ColorCodeTextBox" HorizontalAlignment="Left" Margin="810,75,0,0"  VerticalAlignment="Top" Width="100" FontFamily="Calibri" FontSize="14" TextAlignment="Center"/>
		<Button x:Name="AddHightlightButton" Content="Add" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="920,75,0,0" VerticalAlignment="Top" Width="75" FontFamily="Calibri" Click="AddHightlightButton_Click"/>

		<TextBlock FontFamily="Calibri" FontSize="14" Text="Background Color :" Margin="455,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<TextBox x:Name="BackgroundColorTextBox" HorizontalAlignment="Left" Margin="570,115,0,0" VerticalAlignment="Top" Width="157" FontFamily="Calibri" FontSize="14" TextAlignment="Center"/>
		<Button x:Name="ApplyBGColorButton" Content="Apply Color" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="625,155,0,0" VerticalAlignment="Top" Width="100" FontFamily="Calibri" Click="ApplyBGColorButton_Click"/>

		<TextBlock FontFamily="Calibri" FontSize="14" Text="Text Color :" Margin="740,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<TextBox x:Name="FontColorTextBox" HorizontalAlignment="Left" Margin="810,115,0,0" VerticalAlignment="Top" Width="100" FontFamily="Calibri" FontSize="14" TextAlignment="Center"/>
		<Button x:Name="ApplyTextColorButton" Content="Apply Color" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="810,155,0,0" VerticalAlignment="Top" Width="100" FontFamily="Calibri" Click="ApplyTextColorButton_Click"/>

		<avaloniaedit:TextEditor x:Name="LogTextEditor" Margin="10,0,10,10" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="DimGray"
								 ShowLineNumbers="False" IsReadOnly="False" FontFamily="Calibri" FontSize="16"
								 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
								 Height="450"></avaloniaedit:TextEditor>
	</Grid>
</Window>
