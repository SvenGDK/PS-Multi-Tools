<Window xmlns="https://github.com/avaloniaui"
		xmlns:classes="using:PSMultiTools.Classes"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:menus="using:PSMultiTools.Menus"
		mc:Ignorable="d" d:DesignWidth="1350" d:DesignHeight="650"
		x:Class="PSMultiTools.PS2.PS2Library"
		Title="PS2 Library" Height="650" Width="1350" CanResize="False" CanMinimize="True" RequestedThemeVariant="Dark">

	<Window.Resources>
		<classes:AnyBitmapToAvaloniaConverter x:Key="AnyToAvalonia"/>
	</Window.Resources>

	<Grid>
		<menus:PS2Menu x:Name="NewPS2Menu" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

		<ListBox x:Name="GamesListBox" Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" SelectionMode="Single" Height="300" VerticalAlignment="Top" Margin="5,30,5,0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Hidden">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid Width="200" Height="290">
						<Image Width="174" Height="250" Source="{Binding GameCoverSource, Converter={StaticResource AnyToAvalonia}}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top" >
							<Image.Effect>
								<DropShadowEffect/>
							</Image.Effect>
						</Image>
						<TextBlock Text="{Binding GameTitle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,260,0,0" FontSize="12"  TextAlignment="Center"/>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		<TextBlock x:Name="GameTitleTextBlock" VerticalAlignment="Top" Text="GameTitle" FontSize="48" FontWeight="Bold" Margin="0,338,0,0" HorizontalAlignment="Center" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameIDTextBlock" VerticalAlignment="Top" Text="GameID" FontSize="24" Margin="117,410,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameRegionTextBlock" VerticalAlignment="Top" Text="GameRegion" FontSize="24" TextAlignment="Left" Margin="117,444,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameGenreTextBlock" VerticalAlignment="Top" Text="GameGenre" FontSize="24" TextAlignment="Left" Margin="117,478,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameSizeTextBlock" VerticalAlignment="Top" Text="GameSize" FontSize="24" TextAlignment="Left" Margin="904,410,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameBackupTypeTextBlock" VerticalAlignment="Top" Text="Backup Type :" FontSize="24" TextAlignment="Left" Margin="904,512,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameBackupFolderNameTextBlock" VerticalAlignment="Top" Text="Backup Folder :" FontSize="24" TextAlignment="Left" Margin="904,546,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameDeveloperTextBlock" VerticalAlignment="Top" Text="GameDeveloper" FontSize="24" TextAlignment="Left" Margin="117,512,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GamePublisherTextBlock" VerticalAlignment="Top" Text="GamePublisher" FontSize="24" TextAlignment="Left" Margin="904,444,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameReleaseDateTextBlock" VerticalAlignment="Top" Text="GameReleaseDate" FontSize="24" TextAlignment="Left" Margin="904,478,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>
		<TextBlock x:Name="GameDescriptionTextBlock" VerticalAlignment="Top" Text="GameDescription" FontSize="24" TextAlignment="Left" Margin="117,546,0,0" HorizontalAlignment="Left" FontFamily="Calibri">
			<TextBlock.Effect>
				<DropShadowEffect BlurRadius="3"/>
			</TextBlock.Effect>
		</TextBlock>

		<Decorator x:Name="PSXDatacenterBrowserWrapper" IsVisible="False"></Decorator>
	</Grid>
</Window>
