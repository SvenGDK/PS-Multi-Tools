<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="125"
		x:Class="PSMultiTools.PSXColorSelection"
		Title="Color Selection" Height="125" Width="350">
	<Grid>
		<ColorPicker HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Width="300"></ColorPicker>
		<Button HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Width="300" Content="Confirm" HorizontalContentAlignment="Center" FontWeight="Bold"></Button>
	</Grid>
</Window>
